{
	"name": "@solo-visual/pi-tools-and-skills",
	"version": "1.2.0",
	"description": "Reusable extensions, skills, prompts, and shared libraries for the pi coding agent",
	"directories": {
		"doc": "docs"
	},
	"scripts": {
		"check:namespace": "node scripts/check-namespace.mjs",
		"check:template-safety": "node scripts/check-template-safety.mjs",
		"build:fleet-mcp": "tsc -p fleet-mcp/tsconfig.build.json",
		"pack:extensions": "node scripts/pack-packages.mjs --all",
		"pack:umbrella": "node scripts/pack-packages.mjs --umbrella",
		"start:fleet-mcp": "node dist/fleet-mcp/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint fleet-mcp/ extensions/ lib/ tests/ scripts/ benchmarks/",
		"type-coverage": "type-coverage --strict --at-least 95",
		"security:semgrep": "node scripts/semgrep-scan.mjs",
		"check": "npm run check:namespace && npm run check:template-safety && npm run typecheck && npm run lint && npm run knip && npm run type-coverage",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage --testTimeout=15000",
		"test:watch": "vitest",
		"test:evals": "vitest run tests/evals",
		"benchmark:teams:live": "node benchmarks/team-live-benchmark.mjs",
		"benchmark:goal": "python3 -B benchmarks/goal-benchmark.py",
		"knip": "knip"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tS7hKamAYL84j91/pi-tools-and-skills.git"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"agent-skills"
	],
	"author": "pi-tools-and-skills contributors",
	"license": "MIT",
	"type": "module",
	"files": [
		"extensions",
		"lib",
		"skills",
		"prompts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/*/index.ts"
		],
		"skills": [
			"./skills",
			"./extensions/pi-agent-hub/skills",
			"./extensions/pi-team-workflows/skills"
		],
		"prompts": [
			"./prompts"
		]
	},
	"bugs": {
		"url": "https://github.com/tS7hKamAYL84j91/pi-tools-and-skills/issues"
	},
	"homepage": "https://github.com/tS7hKamAYL84j91/pi-tools-and-skills#readme",
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@earendil-works/pi-coding-agent": "1.0.1",
		"@earendil-works/pi-tui": "1.0.1",
		"@types/node": "^25.5.2",
		"@vitest/coverage-v8": "4.1.11",
		"archunit": "^2.1.66",
		"fast-check": "4.4.0",
		"knip": "^6.3.0",
		"type-coverage": "^2.29.7",
		"typebox": "^1.3.27",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.0",
		"matrix-js-sdk": "^41.9.0",
		"zod": "^4.5.4"
	},
	"engines": {
		"node": ">=22.19"
	},
	"publishConfig": {
		"access": "public"
	}
}
