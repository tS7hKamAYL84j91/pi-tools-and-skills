#!/usr/bin/env bash
set -euo pipefail

# setup-pi — register this reusable pi package.
#
# This repo owns extensions, shared libs, skills, and prompts.
# It does not own runtime model choices, provider defaults, shell hooks,
# Matrix deployments, or project-specific launchers.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PI_TOOLS_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PI_DIR="$HOME/.pi/agent"

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
red()   { printf '\033[31m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }

usage() {
	cat <<'HELP'
Usage: setup-pi [--project <dir>] [package-name]

Registers this checkout as a pi package. Without --project the registration
goes to ~/.pi/agent/settings.json; with --project <dir> it goes to
<dir>/.pi/settings.json for that one project.

With package-name, registers one user-installable extension package
(pi-agent-hub, pi-boost, pi-goal, pi-matrix, pi-ollama-models, pi-overview,
pi-team-workflows).
Project-only packages such as pi-kanban and pi-automations must be enabled
per workspace instead.
Runtime setup belongs in the workspace or infrastructure repo that uses it.
HELP
}

PACKAGE_NAME=""
PROJECT_DIR=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		-h|--help)
			usage
			exit 0
			;;
		--project)
			if [[ $# -lt 2 ]]; then
				red "Error: --project requires a directory"
				usage
				exit 1
			fi
			PROJECT_DIR="$2"
			shift 2
			;;
		--project=*)
			PROJECT_DIR="${1#--project=}"
			shift
			;;
		-*)
			red "Error: Unknown option: $1"
			usage
			exit 1
			;;
		*)
			if [[ -n "$PACKAGE_NAME" ]]; then
				red "Error: Unknown argument: $1"
				usage
				exit 1
			fi
			PACKAGE_NAME="$1"
			shift
			;;
	esac
done

if ! command -v python3 &>/dev/null; then
	red "Error: python3 not found."
	exit 1
fi

if [[ -n "$PROJECT_DIR" ]]; then
	if [[ ! -d "$PROJECT_DIR" ]]; then
		red "Error: project directory not found: $PROJECT_DIR"
		exit 1
	fi
	PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
	SETTINGS_JSON="$PROJECT_DIR/.pi/settings.json"
	SETTINGS_SCOPE="project: $PROJECT_DIR"
else
	SETTINGS_JSON="$PI_DIR/settings.json"
	SETTINGS_SCOPE="global"
fi

mkdir -p "$(dirname "$SETTINGS_JSON")"

bold "── Register pi-tools-and-skills package ──"

SKILLS_DIR="$PI_TOOLS_DIR/skills"
EXTENSIONS_DIR="$PI_TOOLS_DIR/extensions"
PROMPTS_DIR="$PI_TOOLS_DIR/prompts"

if [[ -n "$PACKAGE_NAME" ]]; then
	python3 "$SCRIPT_DIR/pi-package-settings.py" register-package \
		"$SETTINGS_JSON" \
		"$PI_TOOLS_DIR" \
		"$SKILLS_DIR" \
		"$EXTENSIONS_DIR" \
		"$PROMPTS_DIR" \
		"$PACKAGE_NAME"
else
	python3 "$SCRIPT_DIR/pi-package-settings.py" register \
		"$SETTINGS_JSON" \
		"$PI_TOOLS_DIR" \
		"$SKILLS_DIR" \
		"$EXTENSIONS_DIR" \
		"$PROMPTS_DIR"
fi

skill_count=$(find "$SKILLS_DIR" -name "SKILL.md" 2>/dev/null | wc -l | tr -d ' ')
prompt_count=$(find "$PROMPTS_DIR" -name "*.md" 2>/dev/null | wc -l | tr -d ' ')

green "  settings.json updated:"
echo  "    settings:   $SETTINGS_JSON"
echo  "    scope:      $SETTINGS_SCOPE"
if [[ -n "$PACKAGE_NAME" ]]; then
	echo  "    package:    $PI_TOOLS_DIR/extensions/$PACKAGE_NAME"
	echo  "    extensions: from package manifest"
else
	echo  "    package:    $PI_TOOLS_DIR"
	echo  "    extensions: pi-agent-hub, pi-goal (pi-team-workflows is independently installable)"
fi
echo  "    skills:     $skill_count via package"
echo  "    prompts:    $prompt_count via package"
echo  "    models:     unchanged"
echo  "    runtime:    unchanged"

echo ""
if [[ -n "$PROJECT_DIR" ]]; then
	dim "Project package declarations load only after Pi project trust is granted for $PROJECT_DIR."
fi
dim "Project-specific model defaults, shell hooks, secrets, and launchers stay outside this reusable package."
