[Unit]
Description=CoAS daemon: scheduler tick, agent registry, A2A routing (ADR-0018)
Documentation=https://github.com/tS7hKamAYL84j91/pi-tools-and-skills#readme
# Start is an explicit Principal/Quartermaster action (ADR Non-actions):
# no automatic daemon start from Zellij/pi launches.
Wants=network-local.target

[Service]
Type=simple
# Restart=no: repeated crashes must not silently restart-loop; the daemon
# failure-threshold policy (>=3 crashes/24h or state corruption) disables it
# for the workspace and alerts the Principal/Lumen channel (ADR rollback).
Restart=no
WorkingDirectory=%h/git/pi-tools-and-skills
# Built via: npm --prefix daemon run build (tsc -p daemon/tsconfig.emit.json).
ExecStart=/usr/bin/node %h/git/pi-tools-and-skills/daemon/dist/main.js
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%t %h/.local/share/coas-daemon

[Install]
WantedBy=default.target