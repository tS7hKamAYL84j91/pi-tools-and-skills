# Local CLI/library experiment: no servers, databases, or shared containers.
export HARNESS_PROJECT_NAME=pi_tools_and_skills
export HARNESS_USE_WORKTREE=true
export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=3
export HARNESS_ECOSYSTEM="node"
export HARNESS_NODE_PACKAGE_MANAGER="npm"
# Reproducible dependencies without running third-party install hooks.
export HARNESS_INSTALL_CMD="npm ci --ignore-scripts --no-audit --no-fund"
export HARNESS_INFRA_SERVICES=""
export HARNESS_INFRA_PORT_LANES=""
export HARNESS_DB_MIGRATE_CMD=""
export HARNESS_DB_SEED_CMD=""
