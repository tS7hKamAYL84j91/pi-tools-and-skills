{
  "version": "1",
  "artifactsDir": "artifacts",
  "logsDir": "logs",
  "agentSlots": {
    "min": 1,
    "max": 3
  },
  "verificationStages": [
    "typecheck",
    "unit-tests",
    "lint",
    "readiness",
    "check",
    "tests",
    "diff-check"
  ],
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Optional shared Docker infrastructure",
      "artifacts": []
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Prepare agent slot (git worktree, deps, env file)",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline: runs stages.json verificationStages in order (tier \"quick\" by default; --full runs the whole list)",
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs"
        }
      ],
      "acceptsArgs": [
        "--full"
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect agent slot status and worktree path",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Remove worktree and env file for the slot",
      "artifacts": []
    },
    {
      "id": "check",
      "kind": "test",
      "description": "Repository namespace, safety, types, lint, unused code and coverage checks",
      "command": "npm run check",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "tests",
      "kind": "test",
      "description": "Offline Vitest suite; no live benchmark or provider calls",
      "command": "npm test",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "diff-check",
      "kind": "test",
      "description": "Reject whitespace errors",
      "command": "git diff --check",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "quick"
    },
    {
      "id": "typecheck",
      "kind": "test",
      "description": "Type check (ecosystem quick smoke)",
      "command": "${NPM_BIN:-npm} run typecheck",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "quick"
    },
    {
      "id": "unit-tests",
      "kind": "test",
      "description": "Unit tests",
      "command": "${NPM_BIN:-npm} test",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "lint",
      "kind": "test",
      "description": "Lint",
      "command": "${NPM_BIN:-npm} run lint",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "readiness",
      "kind": "test",
      "description": "Project readiness smoke (HARNESS_READINESS_CMD)",
      "script": "stages/readiness.sh",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    }
  ],
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  }
}
